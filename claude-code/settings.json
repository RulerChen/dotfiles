{
  "model": "opus",
  "effortLevel": "high",
  "autoCompactWindow": 400000,

  "permissions": {
    "defaultMode": "auto",
    "ask": ["Bash(git push:*)"]
  },

  "attribution": {
    "commit": "",
    "pr": ""
  },

  "worktree": {
    "baseRef": "fresh"
  },

  "enableWorkflows": false,
  "remoteControlAtStartup": true,

  "theme": "dark",
  "outputStyle": "concise",
  "verbose": true,
  "showThinkingSummaries": true
}
